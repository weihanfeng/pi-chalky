{
  "name": "@chalky/chalky",
  "version": "0.1.5",
  "description": "Chalky on pi: agents build what you see in the browser, and you point at it and mark it up",
  "license": "MIT",
  "type": "module",
  "bin": {
    "chalky": "bin/chalky.mjs"
  },
  "files": [
    "bin/",
    "server.ts",
    "agent/",
    "!agent/auth.json",
    "!agent/models-store.json",
    "!agent/models.json",
    "!agent/mcp-auth.json",
    "!agent/mcp.json",
    "!agent/ui/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bundleDependencies": [
    "xlsx"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "diff3": "0.0.3",
    "dom-to-image-more": "3.11.0",
    "dompurify": "3.4.17",
    "isomorphic-git": "1.44.2",
    "jiti": "2.7.0",
    "mammoth": "1.13.0",
    "marked": "18.0.14",
    "node-pptx-parser": "1.0.1",
    "unpdf": "1.9.1",
    "word-extractor": "1.0.4",
    "ws": "8.22.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
